# Cache everything at the Cloudflare edge
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/mobile/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# HTML — cache at edge for 1 day, browser for 0 (always revalidate from edge)
/*.html
  Cache-Control: public, max-age=0, s-maxage=86400

# Everything else — cache at edge for 1 week, browser for 1 hour
/*
  Cache-Control: public, max-age=3600, s-maxage=604800
